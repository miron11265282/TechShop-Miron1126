; miron1126 TechShop — Godot 4 project
config_version=5

[application]

config/name="miron1126 TechShop"
config/version="2.0.0"
config/description="Мастерская по ремонту компьютеров"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/Data.gd"
Game="*res://scripts/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_repeat=1
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=1
